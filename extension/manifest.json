{
  "manifest_version": 3,
  "name": "내 문장 모음",
  "version": "1.1.0",
  "description": "웹페이지에서 드래그한 문장을 목록별로 저장하고 복사합니다.",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "내 문장 모음"
  },
  "author": "이은정"
}